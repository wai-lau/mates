# Wai: "daily retro should run at 4:30 AM if the computer is on, if not it should run
# as soon as it can". Persistent=true runs a missed 4:30 at the next start of the user
# systemd; with no --date the retro covers every finished day that has no retro yet.
[Unit]
Description=mates daily retro at 04:30

[Timer]
OnCalendar=*-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
