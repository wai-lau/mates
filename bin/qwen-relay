#!/usr/bin/env python3
"""Byte relay between TCP and a unix socket, for the qwen sandbox.

  qwen-relay out --sock S --to 127.0.0.1:PORT [--slots DIR [--priority]]
                                                   (outside: unix socket -> Ollama, chat API only)
  qwen-relay in  --sock S --listen 127.0.0.1:11434 (inside, no network: TCP -> unix socket)
  qwen-relay clip --sock S --run PROG               (outside: each connection's bytes -> PROG's stdin)
  qwen-relay egress --sock S [--web]                (outside: HTTPS proxy for a runtime build;
                                                    --web: for a hand-launched qwen)

The sandbox has no network namespace route out; these sockets are the only
ways to reach the model server and (write-only) the clipboard.

egress is the one way out of a `mates` runtime build (mates/runtime.py): an HTTP
CONNECT proxy that opens a tunnel only to port 443 of a package registry in
REGISTRIES, at a public address. No other host, so an install can't fetch a URL
or git link (from Qwen or anyone) and can't send anything to a host of its
choosing. The name is resolved here, outside, and the tunnel goes to the checked
address, so a name that resolves to loopback, the LAN or the WSL host never
connects: local services stay out of reach (emet's MCP server listens on
127.0.0.1). Each tunnel, allowed or refused, is one line on stderr.

With --web (a qwen Wai launched by hand: "when I start qwen on my own, it should
have network access") any host passes, still only port 443 at a public address:
the web, never loopback, the LAN, the WSL host or the owner's Ollama.

Wai's own qwen goes first on the model (Wai, 2026-11-18: "ensure that any qwen I run myself
takes priority over follower qwens"; her pick: stop a follower reply that is running and start
it over after hers). Ollama answers one request at a time. Every `out` relay shares --slots:
hers (--priority) holds a lock on its claim file there for each chat request and stamps it when
the request ends, so for PRIORITY_GRACE_S after it (the tool calls between her requests) no
follower gets in. A follower relay holds a chat request while a claim is live, and cuts one
already running: the model stops it, OpenCode retries a cut reply by itself ("socket
connection was closed", "terminated"), and the retry waits here until hers is done.
"""
import argparse
import asyncio
import contextlib
import fcntl
import functools
import ipaddress
import os
import re
import socket
import subprocess
import sys
import time

CLIP_MAX = 1 << 20  # a copy bigger than 1 MiB is cut off
# Removed from clipboard text (Qwen sets Wai's clipboard; a paste into a terminal could run it):
# control characters but tab and newline (escape sequences, carriage returns, bells), C1
# controls, and the bidi and zero-width characters that hide or reorder text.
CLIP_DROP = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2060-\u2069\ufeff]")


def clip_text(data):
    """Clipboard bytes made safe to paste: decoded as UTF-8 (bad bytes become U+FFFD),
    CLIP_DROP characters removed, encoded again."""
    return CLIP_DROP.sub("", data.decode("utf-8", "replace")).encode()
EGRESS_PORT = 443
# The package registries a runtime build may download from: exact names, no subdomains.
# Adding one is a code change here, which Wai sees; the lead cannot widen it on its own.
# The two Playwright hosts serve its browsers (PLAYWRIGHT_CDN_MIRRORS in Playwright 1.60);
# Wai, 2026-11-12, picked this option so browser checks build in the sandbox: "A".
REGISTRIES = frozenset({"pypi.org", "files.pythonhosted.org", "registry.npmjs.org",
                        "cdn.playwright.dev", "playwright.download.prss.microsoft.com"})
_LABEL = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
HOST_RE = re.compile(rf"^{_LABEL}(?:\.{_LABEL})*$")


NAT64 = ipaddress.ip_network("64:ff9b::/96")


def public_addr(ip):
    """True only for a globally routed unicast address. An IPv6 address that carries an IPv4
    one (mapped, compatible ::/96, 6to4, NAT64) is judged by that IPv4 address."""
    a = ipaddress.ip_address(ip.split("%", 1)[0])
    if a.version == 6:
        inner = a.ipv4_mapped or a.sixtofour
        if inner is None and (int(a) >> 32 == 0 or a in NAT64):
            inner = ipaddress.IPv4Address(int(a) & 0xFFFFFFFF)
        if inner is not None:
            a = inner
    return a.is_global and not a.is_multicast


def parse_connect(head):
    """(host, port) of a `CONNECT host:port HTTP/1.x` request head; ValueError for anything else."""
    parts = head.split(b"\r\n", 1)[0].decode("ascii").split(" ")
    if len(parts) != 3 or parts[0] != "CONNECT" or not parts[2].startswith("HTTP/1."):
        raise ValueError("not a CONNECT request")
    host, sep, port = parts[1].rpartition(":")
    if not sep or not port.isdigit():
        raise ValueError("no port")
    if host.startswith("[") and host.endswith("]"):
        host = str(ipaddress.IPv6Address(host[1:-1]))
    elif not HOST_RE.match(host):
        raise ValueError("bad host name")
    return host, int(port)


def allowed_host(host, web=False):
    """web (--web): any host; the port and public-address checks still apply."""
    return web or host.lower() in REGISTRIES


def pick_public(infos):
    """[(family, sockaddr)] of the getaddrinfo answers that are public addresses."""
    return [(fam, sa) for fam, _, _, _, sa in infos if public_addr(sa[0])]


def _log(msg):
    print(f"qwen-relay egress: {msg}", file=sys.stderr, flush=True)


async def egress(r, w, web=False):
    def refuse(why, code=b"403 Forbidden"):
        _log(why)
        w.write(b"HTTP/1.1 " + code + b"\r\n\r\n")
        w.close()

    try:
        head = await asyncio.wait_for(r.readuntil(b"\r\n\r\n"), 30)
    except (TimeoutError, asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
        w.close()
        return
    try:
        host, port = parse_connect(head)
    except ValueError as e:
        first = head.split(b"\r\n", 1)[0][:120]
        return refuse(f"refused request {first!r} ({e})")
    target = f"{host}:{port}"
    if port != EGRESS_PORT:
        return refuse(f"refused {target} (only port {EGRESS_PORT})")
    if not allowed_host(host, web):
        return refuse(f"refused {target} (not a package registry)")
    try:
        infos = await asyncio.get_running_loop().getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except OSError:
        return refuse(f"refused {target} (no address)", b"502 Bad Gateway")
    addrs = pick_public(infos)
    if not addrs:
        return refuse(f"refused {target} (not a public address: {sorted({sa[0] for *_, sa in infos})})")
    for fam, sa in addrs:
        try:
            ur, uw = await asyncio.wait_for(asyncio.open_connection(sa[0], sa[1], family=fam), 15)
            break
        except (TimeoutError, OSError):
            continue
    else:
        return refuse(f"failed {target} (no answer)", b"502 Bad Gateway")
    _log(f"allowed {target} -> {sa[0]}")
    w.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
    await w.drain()
    await asyncio.gather(pipe(r, uw), pipe(ur, w))


# The model relay (`out`) passes only these to the owner's Ollama. Everything else there acts
# as the owner with the network: /api/pull fetches from any registry host a model name names
# (data out), and delete/create/copy change the models. One request per connection, read in
# full first (no chunked bodies), sent upstream with Connection: close, so a second request
# can never follow it on the same connection.
MODEL_ROUTES = frozenset({("POST", "/v1/chat/completions"), ("GET", "/v1/models"),
                          ("GET", "/api/version"), ("GET", "/api/tags")})
MODEL_HEAD_MAX = 64 << 10
MODEL_BODY_MAX = 64 << 20  # a full 64K-token chat is a few MB of JSON
HOP_HEADERS = {b"connection", b"keep-alive", b"proxy-connection", b"upgrade", b"te", b"trailer"}


async def model_request(r):
    """(raw request to send upstream, None) or (None, refusal status) for one client request."""
    try:
        head = await r.readuntil(b"\r\n\r\n")
    except (asyncio.IncompleteReadError, asyncio.LimitOverrunError):
        return None, b"400 Bad Request"
    if len(head) > MODEL_HEAD_MAX:
        return None, b"431 Request Header Fields Too Large"
    lines = head[:-4].split(b"\r\n")
    parts = lines[0].split(b" ")
    if len(parts) != 3 or not parts[2].startswith(b"HTTP/1."):
        return None, b"400 Bad Request"
    method, target = parts[0].decode("ascii", "replace"), parts[1].decode("ascii", "replace")
    path = target.split("?", 1)[0]
    if not path.startswith("/") or "/../" in path + "/" or "//" in path or (method, path) not in MODEL_ROUTES:
        return None, b"403 Forbidden"
    headers, length = [], None
    for line in lines[1:]:
        name, sep, value = line.partition(b":")
        key = name.strip().lower()
        if not sep or not key:
            return None, b"400 Bad Request"
        if key == b"transfer-encoding":
            return None, b"411 Length Required"  # chunked bodies are refused: no ambiguity about the end
        if key == b"content-length":
            if length is not None or not value.strip().isdigit():
                return None, b"400 Bad Request"
            length = int(value.strip())
        if key in HOP_HEADERS:
            continue
        headers.append(line)
    if method == "POST" and length is None:
        return None, b"411 Length Required"
    if (length or 0) > MODEL_BODY_MAX:
        return None, b"413 Content Too Large"
    try:
        body = await r.readexactly(length or 0)
    except asyncio.IncompleteReadError:
        return None, b"400 Bad Request"
    return b"\r\n".join([lines[0], *headers, b"Connection: close"]) + b"\r\n\r\n" + body, None


PRIORITY_GRACE_S = 20.0  # after Wai's request ends: her next one follows a tool call or two
PRIORITY_POLL_S = 0.5
CHAT = b"POST /v1/chat/completions "


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def priority_live(slots, grace=PRIORITY_GRACE_S):
    """True while a claim in `slots` is held (Wai's request is running) or ended under `grace`
    seconds ago. The claim of a relay that is gone is removed."""
    try:
        names = os.listdir(slots)
    except OSError:
        return False
    live = False
    for name in names:
        if not (name.startswith("hand-") and name.endswith(".lock")):
            continue
        path = os.path.join(slots, name)
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            continue
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                live = True
                continue
            if time.time() - os.fstat(fd).st_mtime < grace:
                live = True
            elif name[5:-5].isdigit() and not _pid_alive(int(name[5:-5])):
                with contextlib.suppress(OSError):
                    os.unlink(path)
        finally:
            os.close(fd)
    return live


class Claim:
    """Wai's relay: one claim file, locked while any of her chat requests runs."""

    def __init__(self, slots):
        os.makedirs(slots, mode=0o700, exist_ok=True)
        final = os.path.join(slots, f"hand-{os.getpid()}.lock")
        tmp = final + ".new"
        self.fd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        os.utime(self.fd, (0, 0))  # no request yet: no grace
        os.rename(tmp, final)  # a follower never sees it unlocked and new
        self.running = 0

    async def __aenter__(self):
        self.running += 1
        if self.running == 1:
            while True:  # a follower's test lock lasts microseconds
                try:
                    fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    await asyncio.sleep(0.01)

    async def __aexit__(self, *exc):
        self.running -= 1
        if self.running == 0:
            os.utime(self.fd)  # the grace starts now
            fcntl.flock(self.fd, fcntl.LOCK_UN)


def ready_socket(path):
    """A unix socket that is already listening, mode 600, when `path` first appears. bin/qwen and
    the tests wait for the file; bound under its own name, it appeared before listen() and before
    the chmod, so an early connection was refused (the relay tests failed about one run in three)
    and the socket was briefly open to the umask. Bind and listen under a temp name, then rename."""
    tmp = f"{path}.{os.getpid()}.new"
    for old in (tmp, path):
        if os.path.lexists(old):
            os.unlink(old)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(tmp)
    os.chmod(tmp, 0o600)
    s.listen(128)
    os.replace(tmp, path)
    return s


async def pipe(r, w):
    try:
        while (b := await r.read(65536)):
            w.write(b)
            await w.drain()
    except (ConnectionError, asyncio.IncompleteReadError):
        pass
    finally:
        w.close()


async def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", choices=["in", "out", "clip", "egress"])
    ap.add_argument("--sock", required=True)
    ap.add_argument("--to")
    ap.add_argument("--listen")
    ap.add_argument("--run", help="clip: program that takes the text on stdin")
    ap.add_argument("--web", action="store_true", help="egress: any host, not just the registries")
    ap.add_argument("--slots", help="out: the folder all model relays share for Wai's priority")
    ap.add_argument("--priority", action="store_true", help="out: Wai's own qwen: goes before the followers")
    ap.add_argument("--grace", type=float, default=PRIORITY_GRACE_S, help=argparse.SUPPRESS)  # tests
    a = ap.parse_args()
    if a.mode == "clip":
        # Write-only: the sandbox can set the clipboard but never read it.
        async def handle(r, w):
            data = await r.read(CLIP_MAX)
            while len(data) < CLIP_MAX and (more := await r.read(CLIP_MAX - len(data))):
                data += more
            w.close()
            data = clip_text(data)
            if data:
                await asyncio.to_thread(subprocess.run, [a.run], input=data,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        srv = await asyncio.start_unix_server(handle, sock=ready_socket(a.sock))
    elif a.mode == "egress":
        srv = await asyncio.start_unix_server(functools.partial(egress, web=a.web), sock=ready_socket(a.sock))
    elif a.mode == "out":
        host, port = a.to.rsplit(":", 1)
        claim = Claim(a.slots) if a.slots and a.priority else None
        follower = bool(a.slots) and not a.priority

        async def forward(raw, w, cut_when_live):
            try:
                ur, uw = await asyncio.open_connection(host, int(port))
            except OSError:
                w.close()
                return
            uw.write(raw)
            await uw.drain()
            reply = asyncio.create_task(pipe(ur, w))  # the reply only: nothing more goes upstream
            while cut_when_live and not reply.done():
                await asyncio.wait({reply}, timeout=PRIORITY_POLL_S)
                if not reply.done() and priority_live(a.slots, a.grace):
                    # Wai's request wants the model: closing upstream stops this reply there,
                    # and the cut reply makes OpenCode retry, which waits in handle().
                    uw.transport.abort()
                    w.transport.abort()
                    break
            with contextlib.suppress(Exception):
                await reply
            uw.close()

        async def handle(r, w):
            raw, refusal = await model_request(r)
            if refusal:
                w.write(b"HTTP/1.1 " + refusal + b"\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                await w.drain()
                w.close()
                return
            chat = raw.startswith(CHAT)
            if chat and claim:
                async with claim:
                    await forward(raw, w, False)
                return
            if chat and follower:
                while priority_live(a.slots, a.grace):
                    await asyncio.sleep(PRIORITY_POLL_S)
            await forward(raw, w, chat and follower)

        srv = await asyncio.start_unix_server(handle, sock=ready_socket(a.sock), limit=MODEL_HEAD_MAX + 1)
    else:
        host, port = a.listen.rsplit(":", 1)

        async def handle(r, w):
            try:
                ur, uw = await asyncio.open_unix_connection(a.sock)
            except OSError:
                w.close()
                return
            await asyncio.gather(pipe(r, uw), pipe(ur, w))

        srv = await asyncio.start_server(handle, host, int(port))
    async with srv:
        await srv.serve_forever()


if __name__ == "__main__":
    asyncio.run(main())
